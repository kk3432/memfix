#!/bin/sh /etc/rc.common
# ============================================
# memfix 启动脚本 (OpenWrt/procd 兼容)
# 小米AX3000T(联发科版) 内存泄漏监控修复
# 安装路径: /etc/init.d/memfix
# ============================================

START=99
STOP=10

USE_PROCD=1

PROG="/usr/sbin/memfix"
CONF="/etc/memfix.conf"
PIDFILE="/var/run/memfix.pid"

start_service() {
    if [ ! -x "$PROG" ]; then
        echo "memfix 可执行文件不存在或无执行权限: $PROG"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG" foreground
    procd_set_param pidfile "$PIDFILE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    echo "memfix 已启动"
}

stop_service() {
    if [ -f "$PIDFILE" ]; then
        local pid=$(cat "$PIDFILE")
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null
            sleep 1
            kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PIDFILE"
    fi
    echo "memfix 已停止"
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PIDFILE" ]; then
        local pid=$(cat "$PIDFILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "memfix 正在运行，PID=$pid"
            "$PROG" status
            return 0
        fi
    fi
    echo "memfix 未运行"
    return 1
}
